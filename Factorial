import java.util.*;

public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();
        System.out.println(factorial(num));
    }
    public static long factorial(int n){
       long fact = 1;
        for(int i = 1; i <= n; i++){
             fact = fact * i;
        }
        return fact;
    }
}
